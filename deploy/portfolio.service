[Unit]
Description=Portfolio (Next.js) via Docker Compose
Documentation=https://github.com/malasahjagotwin/portfolio
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes

# Where the repo is checked out. The .env holding CONTACT_WEBHOOK_URL is read
# from this directory by `docker compose`.
WorkingDirectory=/opt/portfolio

# --build keeps the image in step with the checkout, so a `git pull` followed
# by `systemctl restart portfolio` is a complete deploy.
ExecStart=/usr/bin/docker compose up -d --build
ExecReload=/usr/bin/docker compose up -d --build
ExecStop=/usr/bin/docker compose down

# The first build compiles Next.js; the default 90s would kill it.
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
